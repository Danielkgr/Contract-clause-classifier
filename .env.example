# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo
LLM_API_KEY=your_openai_api_key_here
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=500

# Training Configuration
TRAIN_MODEL=roberta-base
BATCH_SIZE=8
LR=2e-5
NUM_EPOCHS=3
MAX_LENGTH=512
WEIGHT_DECAY=0.01
WARMUP_STEPS=500
EVAL_STEPS=500
SAVE_STEPS=1000
