# LLM provider: anthropic (Claude, the default) or openai
LLM_PROVIDER=anthropic
# Unset means claude-opus-5-5 for anthropic and gpt-4o-mini for openai.  Other
# Claude choices: claude-sonnet-5-5 or claude-haiku-4-5.
# LLM_MODEL=claude-opus-5-5
# Your key.  Left empty, the key comes from ANTHROPIC_API_KEY or OPENAI_API_KEY.
LLM_API_KEY=
# multi asks about every clause type in one call per chunk; single asks about one
LLM_MODE=multi
# Thinking depth for Opus and Sonnet: low, medium, high, xhigh, or max
LLM_EFFORT=low
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120
LLM_CHUNK_CHARS=24000
LLM_CHUNK_OVERLAP=1000
# Sent only when set.  claude-opus-5-5 and claude-sonnet-5-5 reject it.
# LLM_TEMPERATURE=0
# An OpenAI-compatible server, for the openai provider only
# LLM_BASE_URL=

# Training Configuration
TRAIN_MODEL=roberta-base
BATCH_SIZE=8
LR=2e-5
NUM_EPOCHS=3
MAX_LENGTH=512
WEIGHT_DECAY=0.01
WARMUP_STEPS=500
EVAL_STEPS=500
SAVE_STEPS=1000
WINDOW_STRIDE=128
NEGATIVE_WINDOW_RATIO=1.0
FT_THRESHOLD=0.5
# USD per hour for the inference machine; leave unset to report compute time only
# FT_COST_PER_HOUR=
